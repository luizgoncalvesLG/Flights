# Token da Data API do Travelpayouts (travelpayouts.com > Ferramentas > Data API)
TRAVELPAYOUTS_TOKEN=coloque_seu_token_aqui

# Moeda usada nas consultas (código aceito pela API, ex: brl, usd, eur)
MOEDA=brl

# ID da planilha do Google Sheets (está na URL: /d/ESTE_ID/edit)
GOOGLE_SHEETS_ID=coloque_o_id_da_planilha_aqui

# Caminho do JSON de credenciais da service account do Google Cloud
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json

# Token do bot do Telegram (gerado pelo @BotFather)
TELEGRAM_BOT_TOKEN=coloque_o_token_do_bot_aqui

# Chat IDs para onde as notificações de oportunidade são enviadas
# (um ou mais, separados por vírgula)
TELEGRAM_CHAT_IDS=coloque_um_ou_mais_chat_ids_aqui
